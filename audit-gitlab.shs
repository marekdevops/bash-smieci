#!/bin/bash

# Kolory dla lepszej czytelności
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

TARGET_USER=$1

if [ -z "$TARGET_USER" ]; then
    echo -e "${RED}Błąd: Nie podano nazwy użytkownika.${NC}"
    echo "Użycie: sudo $0 <nazwa_użytkownika>"
    exit 1
fi

# Sprawdzenie czy użytkownik istnieje
if ! id "$TARGET_USER" >/dev/null 2>&1; then
    echo -e "${RED}Błąd: Użytkownik '$TARGET_USER' nie istnieje w systemie.${NC}"
    exit 1
fi

echo "=========================================================="
echo " Raport Audytu Uprawnień GitLab dla: $TARGET_USER"
echo " Data: $(date)"
echo "=========================================================="

# 1. Sprawdzenie członkostwa w grupach
echo -e "\n[1] Grupy użytkownika:"
GROUPS=$(id "$TARGET_USER")
if [[ $GROUPS == *"git-admins"* ]]; then
    echo -e "  - Członkostwo w git-admins: ${GREEN}TAK${NC}"
else
    echo -e "  - Członkostwo w git-admins: ${YELLOW}NIE (Zalecane dla porządku)${NC}"
fi

# 2. Sprawdzenie Sudoers (kluczowy punkt)
echo -e "\n[2] Możliwości SUDO (komendy gitlab-ctl):"
SUDO_L=$(sudo -l -U "$TARGET_USER" 2>/dev/null)

check_sudo_cmd() {
    if echo "$SUDO_L" | grep -E "$1" > /dev/null; then
        echo -e "  - $2: ${GREEN}DOSTĘPNE${NC}"
    else
        echo -e "  - $2: ${RED}BRAK DOSTĘPU${NC}"
    fi
}

check_sudo_cmd "gitlab-ctl status" "Status usług (status)"
check_sudo_cmd "gitlab-ctl restart" "Restart usług (restart)"
check_sudo_cmd "gitlab-ctl tail" "Podgląd logów (tail)"
check_sudo_cmd "gitlab-ctl reconfigure" "Rekonfiguracja (reconfigure)"
check_sudo_cmd "dnf (update|install) gitlab-ee" "Aktualizacja pakietu (dnf)"

# 3. Sprawdzenie dostępu do plików i logów
echo -e "\n[3] Uprawnienia do systemów plików (ACL/Unix):"

check_path_read() {
    if sudo -u "$TARGET_USER" [ -r "$1" ]; then
        echo -e "  - Odczyt $1: ${GREEN}TAK${NC}"
    else
        echo -e "  - Odczyt $1: ${RED}NIE${NC}"
    fi
}

check_path_write() {
    if sudo -u "$TARGET_USER" [ -w "$1" ]; then
        echo -e "  - Zapis $1: ${GREEN}TAK${NC}"
    else
        echo -e "  - Zapis $1: ${YELLOW}NIE (Tylko jeśli zespół ma edytować config)${NC}"
    fi
}

check_path_read "/var/log/gitlab"
check_path_read "/etc/gitlab/gitlab.rb"
check_path_write "/etc/gitlab/gitlab.rb"

# 4. Sprawdzenie środowiska (PATH)
echo -e "\n[4] Środowisko wykonawcze:"
if sudo -u "$TARGET_USER" which gitlab-ctl > /dev/null 2>&1; then
    echo -e "  - gitlab-ctl w PATH: ${GREEN}TAK${NC}"
else
    echo -e "  - gitlab-ctl w PATH: ${RED}NIE (Może wymagać pełnej ścieżki /usr/bin/)${NC}"
fi

# 5. SELinux (Kontekst RHEL)
echo -e "\n[5] Bezpieczeństwo (SELinux):"
SELINUX_STATE=$(getenforce)
echo -e "  - Tryb SELinux: ${YELLOW}$SELINUX_STATE${NC}"
if [ "$SELINUX_STATE" == "Enforcing" ]; then
    echo "    (Upewnij się, że nie ma blokad w /var/log/audit/audit.log przy operacjach gitlab-ctl)"
fi

echo -e "\n=========================================================="
echo " Koniec Audytu"