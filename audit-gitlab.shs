#!/bin/bash

# Kolory dla lepszej czytelności
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Parametr wejściowy
TARGET_NAME=$1

if [ -z "$TARGET_NAME" ]; then
    echo -e "${RED}Błąd: Nie podano nazwy (użytkownika/grupy).${NC}"
    echo "Użycie: sudo $0 <nazwa_użytkownika_i_grupy>"
    exit 1
fi

# Sprawdzenie czy użytkownik i grupa istnieją
USER_EXISTS=false
GROUP_EXISTS=false

if id "$TARGET_NAME" >/dev/null 2>&1; then USER_EXISTS=true; fi
if getent group "$TARGET_NAME" >/dev/null 2>&1; then GROUP_EXISTS=true; fi

echo "=========================================================="
echo " Raport Audytu Uprawnień GitLab dla Tożsamości: $TARGET_NAME"
echo " Użytkownik: $([ "$USER_EXISTS" = true ] && echo -e "${GREEN}ISTNIEJE${NC}" || echo -e "${RED}BRAK${NC}")"
echo " Grupa:      $([ "$GROUP_EXISTS" = true ] && echo -e "${GREEN}ISTNIEJE${NC}" || echo -e "${RED}BRAK${NC}")"
echo " Data:       $(date)"
echo "=========================================================="

if [ "$USER_EXISTS" = false ]; then
    echo -e "${RED}Przerwano: Użytkownik nie istnieje. Dalszy audyt niemożliwy.${NC}"
    exit 1
fi

# 1. Sprawdzenie członkostwa w grupie
echo -e "\n[1] Sprawdzenie powiązania użytkownik-grupa:"
if id -nG "$TARGET_NAME" | grep -qw "$TARGET_NAME"; then
    echo -e "  - Użytkownik '$TARGET_NAME' należy do grupy '$TARGET_NAME': ${GREEN}TAK${NC}"
else
    echo -e "  - Użytkownik '$TARGET_NAME' należy do grupy '$TARGET_NAME': ${RED}NIE${NC}"
fi

# 2. Sprawdzenie Sudoers (na poziomie użytkownika)
echo -e "\n[2] Możliwości SUDO (czy użytkownik/grupa może zarządzać GitLabem):"
SUDO_L=$(sudo -l -U "$TARGET_NAME" 2>/dev/null)

check_sudo_cmd() {
    if echo "$SUDO_L" | grep -E "$1" > /dev/null; then
        echo -e "  - $2: ${GREEN}DOSTĘPNE${NC}"
    else
        echo -e "  - $2: ${RED}BRAK DOSTĘPU${NC}"
    fi
}

check_sudo_cmd "gitlab-ctl status" "Status (status)"
check_sudo_cmd "gitlab-ctl (restart|stop|start)" "Zarządzanie procesami (restart/stop/start)"
check_sudo_cmd "gitlab-ctl tail" "Podgląd logów na żywo (tail)"
check_sudo_cmd "gitlab-ctl reconfigure" "Rekonfiguracja (reconfigure)"
check_sudo_cmd "dnf (update|install) gitlab-ee" "Uprawnienia do aktualizacji pakietu"

# 3. Sprawdzenie uprawnień do plików przez ACL dla GRUPY
echo -e "\n[3] Uprawnienia systemowe (ACL dla grupy '$TARGET_NAME'):"

check_acl() {
    local PATH_TO_CHECK=$1
    if getfacl -p "$PATH_TO_CHECK" 2>/dev/null | grep -q "group:$TARGET_NAME:r"; then
        echo -e "  - Grupa ma dostęp (r) do $PATH_TO_CHECK: ${GREEN}TAK${NC}"
    else
        # Sprawdzenie czy grupa jest właścicielem jeśli nie ma ACL
        if [ "$(stat -c '%G' "$PATH_TO_CHECK")" == "$TARGET_NAME" ]; then
            echo -e "  - Grupa jest właścicielem $PATH_TO_CHECK: ${GREEN}TAK${NC}"
        else
            echo -e "  - Grupa ma dostęp do $PATH_TO_CHECK: ${RED}NIE${NC}"
        fi
    fi
}

check_acl "/var/log/gitlab"
check_acl "/etc/gitlab/gitlab.rb"

# 4. Sprawdzenie możliwości zapisu do configu (istotne przy reconfigure)
if [ -w "/etc/gitlab/gitlab.rb" ] && [ "$(stat -c '%G' /etc/gitlab/gitlab.rb)" == "$TARGET_NAME" ]; then
     echo -e "  - Możliwość edycji gitlab.rb przez grupę: ${GREEN}TAK${NC}"
else
     echo -e "  - Możliwość edycji gitlab.rb przez grupę: ${YELLOW}NIE (Tylko root)${NC}"
fi

# 5. Podsumowanie środowiska
echo -e "\n[4] Środowisko wykonawcze RHEL:"
echo -e "  - SELinux status: $(getenforce)"
if [ -f "/etc/gitlab/gitlab-secrets.json" ]; then
    if sudo -u "$TARGET_NAME" [ ! -r "/etc/gitlab/gitlab-secrets.json" ]; then
        echo -e "  - ${YELLOW}Uwaga:${NC} Użytkownik nie może czytać gitlab-secrets.json. Może to utrudnić niektóre zadania rake."
    fi
fi

echo -e "\n=========================================================="
echo " Koniec Audytu"